# Portfolio API - Environment Configuration Template
# Copy this file to .env.development (dev) or .env.production (prod)
# and replace the placeholder values below. Never commit real credentials.

# Server Configuration
# Node environment: development | production
NODE_ENV=development

# Port the API listens on
PORT=3000

# MongoDB Connection
# Local (Compass):  mongodb://localhost:27017/portfolio-api-dev
# Atlas example:    mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/portfolio-api-dev

# CORS Configuration
# Comma-separated origins, or * to allow all
CORS_ORIGIN=*

# Swagger Documentation
# Set to false to disable /docs in production
SWAGGER_ENABLED=true

# Logging
# dev (concise) | combined (Apache-style, recommended for production)
LOG_FORMAT=dev
